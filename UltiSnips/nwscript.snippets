snippet 'swi*(t)*(c)*(h)*' "switch case statement snippet" br
switch ($1)
{
    case $2: ${3:/* TODO */}; break;
    default: ${4:/* TODO */}; break;
}
$0
endsnippet

snippet 'cas*(e)*' "case statement snippet" br
case ${1}: ${2:/* TODO */}; break;
$0
endsnippet

snippet main "void main function" b
void main()
{
	$0
}
endsnippet

snippet 'cond*(i)*(t)*' "StartingConditional function" br
int StartingConditional()
{
	return $0;
}
endsnippet

snippet '(#)*(i)*(n)*(c)*' "Include script" br
#include "${1}"
$0
endsnippet

snippet if "if block" b
if (${1})
{
	${VISUAL}$0
}
endsnippet

snippet 'els*(e)*' "else" br
else
{
	${1:// TODO};
}
$0
endsnippet

snippet ifelse "if with else conditional snippet" b
if (${1:condition})
{
	${2:// TODO};
}
else
{
	${3:// TODO};
}
$0
endsnippet

snippet ifelseif "if with else if conditional snippet" b
if (${1:condition})
{
	${2:// TODO};
}
else if (${3:condition})
{
	${4:// TODO};
}
$0
endsnippet

snippet elseif "else if conditional snippet" b
else if (${1:condition})
{
	${2:// TODO};
}
$0
endsnippet

snippet for "for loop" b
for (${1:i} = 0; $1 < ${2:count}; ${3:$1++})
{
	${VISUAL}$0
}
endsnippet

snippet 'whi*(l)*(e)*' "while loop" br
while (${1})
{
	${VISUAL}$0
}
endsnippet

snippet 'dow*(h)*(i)*(l)*(e)*' "do while loop" br
do
{
	${VISUAL}$0
}
while (${1})
endsnippet

snippet 'str*(u)*(c)*(t)*' "struct" br
struct ${1}
{
	$0
};
endsnippet

snippet 'funcd*(e)*(f)*' "Function definition" br
${1:void} ${2:FunctionName}(${3})
{
	${VISUAL}$0
}
endsnippet

snippet 'funcp*(r)*(o)*(t)*' "Function prototype" br
// ---< ${1:FunctionName} >---
// ---< `!v expand('%:t:r')` >---
// $4
${2:void} $1(${3});
$0
endsnippet

snippet 'const*(a)*(n)*(t)*' "Constant definition" br
const ${1:type} ${2:name} = ${3:value};$0
endsnippet


snippet cblock "Commented block" b
// ----------------------------------------------------------------------------------
// ${1:text}
// ----------------------------------------------------------------------------------
$0
endsnippet

snippet cline "Commented divider line" b
// ----------------------------------------------------------------------------------
$0
endsnippet

snippet ctext "Commented divider line with text" b
// ----- ${1:text}
$0
endsnippet

snippet meta "File metadata" b
//:://///////////////////////////////////////////////////////////////////////////////
//:: `!v expand('%:t')`
//:: `!v expand('%:t:r')`
//:://///////////////////////////////////////////////////////////////////////////////
/*
${1:Description}
*/
//:://///////////////////////////////////////////////////////////////////////////////
//::Created By: ${2:Name} (${3:Nick}) <${4:e-mail}>, `date +'%d/%b/%Y'`
//:://///////////////////////////////////////////////////////////////////////////////
$0
endsnippet

snippet metamod "File metadata modified" b
//::Modified By: ${1:Name} (${2:Nick}) <${3:e-mail}>, `date +'%d/%b/%Y'` $0
endsnippet

snippet metaalt "Alternate File metadata" b
/// ---------------------------------------------------------------------------------
/// @file   `!v expand('%:t')`
/// @author ${1:Name} (${2:Nick}) <${3:e-mail}>
/// @brief  ${4:Description}
/// ---------------------------------------------------------------------------------
$0
endsnippet

snippet metasystem "File metadata" b
-- // -------------------------------------------------------------------------------
-- //    File: `!v expand('%:t')`
-- //  System: ${1:SystemName} (${2:ScriptType})
-- //     URL: ${3:repo}
-- // Authors: ${4:name} (${5:nick}) <${6:email}>
-- // -------------------------------------------------------------------------------
-- // ${7:description}
-- // -------------------------------------------------------------------------------
$0
endsnippet

snippet curdate "Current date" b
`date +'%d/%b/%Y'`$0
endsnippet

snippet curdatealt "Alternate Current date" b
`date +'%d/%m/%Y'`$0
endsnippet

snippet date "Input date" b
${1:day}/${2:month}/${3:year}$0
endsnippet
