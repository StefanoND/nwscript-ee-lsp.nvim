snippet main "void main function" b
void main()
{
	$0
}
endsnippet

snippet "cond*(i)*(t)*" "StartingConditional function" br
int StartingConditional()
{
	return $0;
}
endsnippet

snippet '(#)*(i)*(n)*(c)*' "Include script" br
#include "${1}"
$0
endsnippet

snippet if "if block" b
if (${1})
{
	${VISUAL}$0
}
endsnippet

snippet for "for loop" b
for (${1:i} = 0; $1 < ${2:count}; ${3:$1++})
{
	${VISUAL}$0
}
endsnippet

snippet 'whi*(l)*(e)*' "while loop" br
while (${1})
{
	${VISUAL}$0
}
endsnippet

snippet 'dow*(h)*(i)*(l)*(e)*' "do while loop" br
do
{
	${VISUAL}$0
}
while (${1})
endsnippet

snippet 'str*(u)*(c)*(t)*' "struct" br
struct ${1}
{
	$0
};
endsnippet

snippet 'funcd*(e)*(f)*' "Function definition" br
${1:void} ${2:FunctionName}(${3})
{
	${VISUAL}$0
}
endsnippet

snippet funcp "Function prototype" b
// ---< ${1:FunctionName} >---
// ---< `!v expand('%:t:r')` >---
// $4
${2:void} $1(${3});
$0
endsnippet

snippet 'const*(a)*(n)*(t)*' "Constant definition" br
const ${1:type} ${2:name} = ${3:value};$0
endsnippet


snippet cblock "Commented block" b
// -----------------------------------------------------------------------------
// ${1:text}
// -----------------------------------------------------------------------------
$0
endsnippet

snippet cline "Commented divider line" b
// -----------------------------------------------------------------------------
$0
endsnippet

snippet ctext "Commented divider line with text" b
// ----- ${1:text}
$0
endsnippet

snippet meta "File metadata" b
/// ----------------------------------------------------------------------------
/// @file   `!v expand('%:t')`
/// @author ${1:Name} (${2:Nick}) <${3:e-mail}>
/// @brief  ${4:Description}
/// ----------------------------------------------------------------------------
$0
endsnippet
